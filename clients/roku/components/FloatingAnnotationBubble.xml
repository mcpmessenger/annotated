<?xml version="1.0" encoding="utf-8" ?>
<component name="FloatingAnnotationBubble" extends="Group">
  <script type="text/brightscript" uri="pkg:/components/FloatingAnnotationBubble.brs" />

  <interface>
    <field id="annotationData" type="assocarray" onChange="onDataChange" />
    <field id="bubbleState" type="string" value="CLOSED" onChange="onStateChange" />
  </interface>

  <children>
    <Animation id="fadeAnim" duration="0.2" repeat="false" easeFunction="linear">
      <FloatFieldInterpolator id="opacityInterp" key="[0.0, 1.0]" keyValue="[0.0, 1.0]" fieldToInterp="bubbleGroup.opacity" />
      <Vector2DFieldInterpolator id="slideInterp" key="[0.0, 1.0]" keyValue="[[1250, 470], [1250, 420]]" fieldToInterp="bubbleGroup.translation" />
    </Animation>

    <Group id="bubbleGroup" translation="[1300, 260]" opacity="0.0">
      <Rectangle width="500" height="560" color="0x000000AA" translation="[4, 4]" />
      
      <Rectangle id="bubbleBg" width="500" height="560" color="0x1A243BE6">
        <Rectangle id="topAccent" width="500" height="6" color="0xEF4444FF" />

        <Label text="File a Claim" font="font:LargeBoldSystemFont" color="0xEF4444FF" translation="[20, 24]" />
        
        <Label text="To dispute or claim this content scan the QR code." font="font:SmallSystemFont" color="0xCBD5E1FF" width="460" wrap="true" maxLines="4" translation="[20, 80]" />
        
        <!-- Large QR Code for Disputing -->
        <Rectangle width="300" height="300" color="0xFFFFFFFF" translation="[100, 200]">
            <Poster id="disputeQrCode" width="284" height="284" translation="[8, 8]" loadDisplayMode="scaleToFit" />
        </Rectangle>

        
      </Rectangle>
    </Group>
  </children>
</component>
