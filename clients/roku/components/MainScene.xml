<?xml version="1.0" encoding="utf-8" ?>
<component name="MainScene" extends="Scene">
  <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />

  <children>
    <!-- Background Canvas (Dark Theme #090D16) -->
    <!-- Roku Plane Architecture: Hardware video plane renders BEHIND graphics plane.
         Framing rectangles surround the video viewport [80, 110] to [1220, 750] so video plane is unblocked -->
    <Group id="bgRect" visible="false" />
    <Rectangle id="bgHeader" width="1920" height="110" color="0x090D16FF" translation="[0, 0]" />
    <Rectangle id="bgLeft" width="80" height="640" color="0x090D16FF" translation="[0, 110]" />
    <Rectangle id="bgBottom" width="1220" height="330" color="0x090D16FF" translation="[0, 750]" />
    <Rectangle id="bgRight" width="700" height="970" color="0x090D16FF" translation="[1220, 110]" />

    <!-- Top Navigation Header -->
    <Group id="headerGroup" translation="[80, 40]">
      <!-- Official App Logo -->
      <Poster
        id="appLogo"
        uri="pkg:/images/annotated_logo_512.png"
        width="44"
        height="44"
        translation="[0, 0]" />

      <!-- Brand Wordmark: Lowercase 'annotated' with red period '.' -->
      <Group id="brandWordmark" translation="[56, 2]">
        <Label
          id="appTitle"
          text="annotated"
          font="font:LargeBoldSystemFont"
          color="0xFFFFFFFF"
          translation="[0, 0]" />
        <Label
          id="brandPeriod"
          text="."
          font="font:LargeBoldSystemFont"
          color="0xEF4444FF"
          translation="[218, 0]" />
      </Group>

      <!-- Subtitle -->
      <Label
        id="appSubtitle"
        text="|  Live Video Annotation &amp; Fact-Checking"
        font="font:MediumSystemFont"
        color="0x94A3B8FF"
        translation="[326, 8]" />

      <!-- Right Indicator / Remote Hint -->
      <Label
        id="remoteHint"
        text="[*] Browse Notes   [>] Enter Rail   [OK] Action"
        font="font:SmallBoldSystemFont"
        color="0x64748BFF"
        horizAlign="right"
        width="760"
        translation="[1000, 10]" />
    </Group>

    <!-- Main Video Stage (Left: 1140px wide) -->
    <Group id="stageGroup" translation="[80, 110]">
      <!-- Transparent Video Container -->
      <Group id="videoFrame">
        <!-- Embedded Video Player Node (Continuous Loop) -->
        <Video
          id="mainVideo"
          width="1140"
          height="640"
          loop="true"
          visible="true" />

        <!-- Crisp Frame Border Lines around video viewport -->
        <Rectangle width="1140" height="2" color="0x1F2937FF" translation="[0, 0]" />
        <Rectangle width="1140" height="2" color="0x1F2937FF" translation="[0, 638]" />
        <Rectangle width="2" height="640" color="0x1F2937FF" translation="[0, 0]" />
        <Rectangle width="2" height="640" color="0x1F2937FF" translation="[1138, 0]" />

        <!-- Video Overlay Header (Title & Timestamp) with translucent tint -->
        <Rectangle
          id="videoOverlayTop"
          width="1140"
          height="54"
          color="0x00000088">
          <Label
            id="videoTitle"
            text="Loading community annotations..."
            font="font:MediumBoldSystemFont"
            color="0xFFFFFFFF"
            width="880"
            translation="[20, 14]" />
          <Label
            id="timestampBadge"
            text="00:00 / 00:00"
            font="font:MediumBoldSystemFont"
            color="0x38BDF8FF"
            translation="[920, 14]" />
        </Rectangle>
      </Group>

      <!-- Action Pill Bar (Directly below video) -->
      <Group id="actionBarGroup" translation="[0, 660]">
        <!-- Fact Check Pill Button -->
        <Rectangle
          id="btnFactCheck"
          width="190"
          height="52"
          color="0x064E3BFF"
          translation="[0, 0]">
          <Poster id="btnFcIcon" uri="pkg:/images/icon_bolt.png" width="24" height="24" translation="[16, 14]" />
          <Label
            id="lblFactCheck"
            text="Verified"
            font="font:MediumBoldSystemFont"
            color="0x34D399FF"
            translation="[48, 12]" />
        </Rectangle>

        <!-- Reaction: Fire -->
        <Rectangle id="btnFire" width="105" height="52" color="0x1F2937FF" translation="[205, 0]">
          <Poster uri="pkg:/images/icon_fire.png" width="24" height="24" translation="[14, 14]" />
          <Label id="lblFireCount" text="0" font="font:MediumBoldSystemFont" color="0xFFFFFFFF" translation="[46, 12]" />
        </Rectangle>

        <!-- Reaction: Think -->
        <Rectangle id="btnThink" width="105" height="52" color="0x1F2937FF" translation="[325, 0]">
          <Poster uri="pkg:/images/icon_think.png" width="24" height="24" translation="[14, 14]" />
          <Label id="lblThinkCount" text="0" font="font:MediumBoldSystemFont" color="0xFFFFFFFF" translation="[46, 12]" />
        </Rectangle>

        <!-- Reaction: Idea -->
        <Rectangle id="btnIdea" width="105" height="52" color="0x1F2937FF" translation="[445, 0]">
          <Poster uri="pkg:/images/icon_idea.png" width="24" height="24" translation="[14, 14]" />
          <Label id="lblIdeaCount" text="0" font="font:MediumBoldSystemFont" color="0xFFFFFFFF" translation="[46, 12]" />
        </Rectangle>

        <!-- Reaction: 100 -->
        <Rectangle id="btnHundred" width="115" height="52" color="0x1F2937FF" translation="[565, 0]">
          <Poster uri="pkg:/images/icon_100.png" width="28" height="24" translation="[12, 14]" />
          <Label id="lblHundredCount" text="0" font="font:MediumBoldSystemFont" color="0xFFFFFFFF" translation="[48, 12]" />
        </Rectangle>

        <!-- Reaction: Down -->
        <Rectangle id="btnDown" width="105" height="52" color="0x1F2937FF" translation="[695, 0]">
          <Poster uri="pkg:/images/icon_down.png" width="24" height="24" translation="[14, 14]" />
          <Label id="lblDownCount" text="0" font="font:MediumBoldSystemFont" color="0xFFFFFFFF" translation="[46, 12]" />
        </Rectangle>
      </Group>

      <!-- Active Fact Check Detail Card (Directly below action bar) -->
      <Rectangle
        id="factCheckBanner"
        width="1140"
        height="140"
        color="0x064E3BDD"
        translation="[0, 730]">
        <Rectangle id="fcBorder" width="6" height="140" color="0x34D399FF" translation="[0, 0]" />
        <Poster id="fcIcon" uri="pkg:/images/icon_bolt.png" width="28" height="28" translation="[24, 16]" />
        <Label
          id="fcHeadline"
          text="COMMUNITY FACT CHECK: VERIFIED ACCURATE"
          font="font:MediumBoldSystemFont"
          color="0x34D399FF"
          translation="[62, 18]" />
        <Label
          id="fcDetail"
          text="The community verified the referenced claims against primary sources. Multi-source consensus confirmed."
          font="font:SmallSystemFont"
          color="0xF1F5F9FF"
          width="1060"
          wrap="true"
          maxLines="2"
          translation="[24, 60]" />
      </Rectangle>
    </Group>

    <!-- Backdrop Glassmorphic Panel for Active Rail Browsing (State B) -->
    <Group id="railBackdropGroup" translation="[1230, 95]" visible="false">
      <!-- Dark Frosted Backdrop -->
      <Rectangle
        id="railBackdrop"
        width="630"
        height="950"
        color="0x030712F2" />
      <!-- Left Cyan Accent Border Line -->
      <Rectangle
        id="railBackdropBorder"
        width="2"
        height="950"
        color="0x38BDF866" />
      <!-- Mode Badge Indicator -->
      <Rectangle
        id="railModeBadge"
        width="170"
        height="28"
        color="0x0284C733"
        translation="[436, 12]">
        <Label
          text="ACTIVE BROWSING"
          font="font:SmallBoldSystemFont"
          color="0x38BDF8FF"
          horizAlign="center"
          width="170"
          translation="[0, 5]" />
      </Rectangle>
    </Group>

    <!-- Right-Hand Rail: Live Synced Community Notes (620px wide) -->
    <Group id="railGroup" translation="[1250, 110]">
      <Rectangle
        id="railHeaderBg"
        width="590"
        height="52"
        color="0x1E293BFF">
        <Label
          id="railTitle"
          text="Community Notes"
          font="font:MediumBoldSystemFont"
          color="0xFFFFFFFF"
          translation="[20, 12]" />
        <Label
          id="railCount"
          text="Loading..."
          font="font:SmallBoldSystemFont"
          color="0x38BDF8FF"
          horizAlign="right"
          width="220"
          translation="[350, 14]" />
      </Rectangle>

      <!-- Note Card 1 (Active Synced / Focusable) -->
      <Rectangle
        id="card1Outline"
        width="594"
        height="264"
        color="0x38BDF8FF"
        translation="[-2, 66]"
        visible="false" />
      <Rectangle
        id="card1"
        width="590"
        height="260"
        color="0x0F172AFF"
        translation="[0, 68]">
        <Rectangle id="card1Accent" width="590" height="4" color="0x38BDF8FF" translation="[0, 0]" />
        <Label id="card1Author" text="@annotated" font="font:MediumBoldSystemFont" color="0xF8FAFCFF" translation="[20, 16]" />
        <Label id="card1Time" text="Live" font="font:SmallBoldSystemFont" color="0x38BDF8FF" translation="[500, 16]" />
        
        <Label
          id="card1Quote"
          text="Connecting to database..."
          font="font:SmallSystemFont"
          color="0x94A3B8FF"
          width="540"
          maxLines="1"
          translation="[20, 56]" />
          
        <Label
          id="card1Note"
          text="Fetching real-time community notes..."
          font="font:SmallSystemFont"
          color="0xE2E8F0FF"
          width="540"
          wrap="true"
          maxLines="2"
          translation="[20, 96]" />
        
        <Group translation="[20, 210]">
          <Poster uri="pkg:/images/icon_fire.png" width="20" height="20" translation="[0, 0]" />
          <Label id="card1FireCount" text="0" font="font:SmallSystemFont" color="0x94A3B8FF" translation="[26, 0]" />
          <Poster uri="pkg:/images/icon_idea.png" width="20" height="20" translation="[70, 0]" />
          <Label id="card1IdeaCount" text="0" font="font:SmallSystemFont" color="0x94A3B8FF" translation="[96, 0]" />
          <Poster id="card1FcIcon" uri="pkg:/images/icon_bolt.png" width="20" height="20" translation="[140, 0]" />
          <Label id="card1FcLabel" text="Verified" font="font:SmallBoldSystemFont" color="0x34D399FF" translation="[166, 0]" />
        </Group>
      </Rectangle>

      <!-- Note Card 2 -->
      <Rectangle
        id="card2Outline"
        width="594"
        height="224"
        color="0x38BDF8FF"
        translation="[-2, 343]"
        visible="false" />
      <Rectangle
        id="card2"
        width="590"
        height="220"
        color="0x111827FF"
        translation="[0, 345]">
        <Rectangle id="card2Accent" width="590" height="4" color="0x1E293BFF" translation="[0, 0]" />
        <Label id="card2Author" text="@community" font="font:MediumBoldSystemFont" color="0xF8FAFCFF" translation="[20, 16]" />
        <Label id="card2Time" text="" font="font:SmallBoldSystemFont" color="0x64748BFF" translation="[500, 16]" />
        <Label
          id="card2Note"
          text="Waiting for feed..."
          font="font:SmallSystemFont"
          color="0xE2E8F0FF"
          width="540"
          wrap="true"
          maxLines="2"
          translation="[20, 56]" />
        <Group translation="[20, 170]">
          <Poster uri="pkg:/images/icon_100.png" width="24" height="20" translation="[0, 0]" />
          <Label id="card2HundredCount" text="0" font="font:SmallSystemFont" color="0x94A3B8FF" translation="[30, 0]" />
          <Poster uri="pkg:/images/icon_think.png" width="20" height="20" translation="[70, 0]" />
          <Label id="card2ThinkCount" text="0" font="font:SmallSystemFont" color="0x94A3B8FF" translation="[96, 0]" />
          <Poster id="card2FcIcon" uri="pkg:/images/icon_think.png" width="20" height="20" translation="[140, 0]" />
          <Label id="card2FcLabel" text="Context Needed" font="font:SmallBoldSystemFont" color="0x818CF8FF" translation="[166, 0]" />
        </Group>
      </Rectangle>

      <!-- Note Card 3 -->
      <Rectangle
        id="card3Outline"
        width="594"
        height="274"
        color="0x38BDF8FF"
        translation="[-2, 583]"
        visible="false" />
      <Rectangle
        id="card3"
        width="590"
        height="270"
        color="0x111827FF"
        translation="[0, 585]">
        <Rectangle id="card3Accent" width="590" height="4" color="0x1E293BFF" translation="[0, 0]" />
        <Label id="card3Author" text="@community" font="font:MediumBoldSystemFont" color="0xF8FAFCFF" translation="[20, 16]" />
        <Label id="card3Time" text="" font="font:SmallBoldSystemFont" color="0x64748BFF" translation="[500, 16]" />
        <Label
          id="card3Note"
          text="Waiting for feed..."
          font="font:SmallSystemFont"
          color="0xE2E8F0FF"
          width="540"
          wrap="true"
          maxLines="3"
          translation="[20, 56]" />
        <Group translation="[20, 220]">
          <Poster uri="pkg:/images/icon_fire.png" width="20" height="20" translation="[0, 0]" />
          <Label id="card3FireCount" text="0" font="font:SmallSystemFont" color="0x94A3B8FF" translation="[26, 0]" />
          <Poster uri="pkg:/images/icon_idea.png" width="20" height="20" translation="[70, 0]" />
          <Label id="card3IdeaCount" text="0" font="font:SmallSystemFont" color="0x94A3B8FF" translation="[96, 0]" />
          <Poster id="card3FcIcon" uri="pkg:/images/icon_bolt.png" width="20" height="20" translation="[140, 0]" />
          <Label id="card3FcLabel" text="Verified" font="font:SmallBoldSystemFont" color="0x34D399FF" translation="[166, 0]" />
        </Group>
      </Rectangle>
    </Group>

    <!-- ======================================================== -->
    <!-- CINEMATIC DRAMATIC OPENING OVERLAY WITH BRAND IDENTITY   -->
    <!-- ======================================================== -->
    <Group id="introOverlay" visible="true" opacity="1.0">
      <Rectangle
        id="introBg"
        width="1920"
        height="1080"
        color="0x030712FF" />

      <!-- Center Official Emblem -->
      <Group id="introCenterGroup" translation="[960, 420]">
        <Poster
          id="introLogo"
          uri="pkg:/images/annotated_logo_512.png"
          width="160"
          height="160"
          translation="[-80, -80]"
          opacity="0.0" />
      </Group>

      <!-- Brand Wordmark Reveal: 'annotated.' -->
      <Group id="introWordmarkGroup" translation="[845, 540]" opacity="0.0">
        <Label
          id="introTitle"
          text="annotated"
          font="font:LargeBoldSystemFont"
          color="0xFFFFFFFF"
          translation="[0, 0]" />
        <Label
          id="introPeriod"
          text="."
          font="font:LargeBoldSystemFont"
          color="0xEF4444FF"
          translation="[218, 0]" />
      </Group>

      <Label
        id="introTagline"
        text="THE PUBLIC ANNOTATION LAYER FOR VIDEO"
        font="font:MediumBoldSystemFont"
        color="0xFBBF24FF"
        horizAlign="center"
        width="1920"
        translation="[0, 605]"
        opacity="0.0" />

      <Rectangle
        id="introStatusPill"
        width="260"
        height="40"
        color="0x1E293BEE"
        translation="[830, 685]"
        opacity="0.0">
        <Label
          text="CONNECTING LIVE FEED..."
          font="font:SmallBoldSystemFont"
          color="0x38BDF8FF"
          horizAlign="center"
          width="260"
          translation="[0, 10]" />
      </Rectangle>

      <!-- SceneGraph Animation Sequences -->
      <Animation id="introAnim" duration="2.5" repeat="false" easeFunction="linear">
        <FloatFieldInterpolator
          key="[0.0, 0.2, 0.7, 0.9, 1.0]"
          keyValue="[0.0, 1.0, 1.0, 1.0, 0.0]"
          fieldToInterp="introLogo.opacity" />

        <FloatFieldInterpolator
          key="[0.0, 0.3, 0.7, 0.9, 1.0]"
          keyValue="[0.0, 1.0, 1.0, 1.0, 0.0]"
          fieldToInterp="introWordmarkGroup.opacity" />

        <FloatFieldInterpolator
          key="[0.0, 0.4, 0.7, 0.9, 1.0]"
          keyValue="[0.0, 1.0, 1.0, 1.0, 0.0]"
          fieldToInterp="introTagline.opacity" />

        <FloatFieldInterpolator
          key="[0.0, 0.5, 0.8, 0.9, 1.0]"
          keyValue="[0.0, 1.0, 1.0, 0.5, 0.0]"
          fieldToInterp="introStatusPill.opacity" />

        <FloatFieldInterpolator
          key="[0.0, 0.8, 1.0]"
          keyValue="[1.0, 1.0, 0.0]"
          fieldToInterp="introOverlay.opacity" />
      </Animation>
    </Group>
  </children>
</component>
