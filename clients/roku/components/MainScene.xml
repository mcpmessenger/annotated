    <!-- Cinematic Intro Overlay (Netflix / Prime slow zoom on lowercase 'annotated.') -->
    <Group id="introOverlay" visible="true" opacity="1.0">
      <Rectangle
        id="introBg"
        width="1920"
        height="1080"
        color="0x030712FF" />

      <!-- Cinematic Wordmark with Scale Zoom -->
