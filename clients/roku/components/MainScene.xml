<?xml version="1.0" encoding="utf-8" ?>
<component name="MainScene" extends="Scene">
  <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />

  <children>
    <!-- Background Canvas (Dark Theme #090D16) -->
    <Rectangle
      id="bgRect"
      width="1920"
      height="1080"
      color="0x090D16FF" />

    <!-- Top Navigation Header -->
    <Group id="headerGroup" translation="[80, 40]" visible="false">
      <!-- Official App Logo -->
      <Poster
        id="appLogo"
        uri="pkg:/images/annotated_logo_512.png"
        width="44"
        height="44"
        translation="[0, 0]" />

      <!-- Brand Wordmark: Lowercase 'annotated' with red period '.' -->
      <Group id="brandWordmark" translation="[56, 2]">
        <Label
          id="appTitle"
          text="annotated"
          font="font:LargeBoldSystemFont"
          color="0xFFFFFFFF"
          translation="[0, 0]" />
        <Label
          id="brandPeriod"
          text="."
          font="font:LargeBoldSystemFont"
          color="0xEF4444FF"
          translation="[218, 0]" />
      </Group>

      <!-- Subtitle -->
      <Label
        id="appSubtitle"
        text="|  Live Video Annotation &amp; Fact-Checking"
        font="font:MediumSystemFont"
        color="0x94A3B8FF"
        translation="[326, 8]" />

      <!-- Right Indicator / Remote Hint -->
      <Label
        id="remoteHint"
        text="[^/v] Next/Prev   [>] Rail   [OK] Detail [QR]"
        font="font:SmallBoldSystemFont"
        color="0x64748BFF"
        horizAlign="right"
        width="760"
        translation="[1000, 10]" />
    </Group>

    <!-- Main Video Stage (Fullscreen 1920x1080) -->
    <Group id="stageGroup" translation="[0, 0]">
      <Rectangle
        id="videoFrame"
        width="1920"
        height="1080"
        color="0x000000FF">

        <!-- Embedded Video Player Node (Continuous Loop) -->
        <Video
          id="mainVideo"
          width="1920"
          height="1080"
          translation="[0,0]"
          visible="true" />

        <!-- Tweet / Text Billboard Canvas (Active when focused note has no video) -->
        <Group id="tweetBillboardGroup" visible="false">
          <!-- Glassmorphic Backdrop -->
          <Rectangle width="1920" height="1080" color="0x0B1220F8" />
          <Rectangle width="1920" height="6" color="0x38BDF8FF" />

          <Group translation="[360, 160]">
            <!-- Original Source Area -->
            <Rectangle id="bbPlatformBg" width="190" height="34" color="0x1E293BEE" translation="[0, 0]">
              <Label id="bbPlatform" text="X / Twitter" font="font:SmallBoldSystemFont" color="0x38BDF8FF" horizAlign="center" width="190" translation="[0, 8]" />
            </Rectangle>
            <Label id="bbDomain" text="x.com" font="font:SmallSystemFont" color="0x94A3B8FF" translation="[210, 6]" />

            <!-- Original Quote -->
            <Label id="bbQuote" text="Quote" font="font:MediumBoldSystemFont" color="0xFFFFFFFF" width="1200" wrap="true" maxLines="6" lineSpacing="10" translation="[0, 80]" />
            
            <Rectangle width="1200" height="2" color="0x1E293BFF" translation="[0, 380]" />

            <!-- Annotation Area -->
            <Poster id="bbAnnotatorAvatar" width="64" height="64" loadDisplayMode="scaleToFill" translation="[0, 420]" />
            <Label id="bbAuthor" text="@community" font="font:LargeBoldSystemFont" color="0x38BDF8FF" translation="[80, 436]" />

            <Rectangle id="bbIntentPill" width="6" height="120" color="0x34D399FF" translation="[0, 520]" />
            <Label id="bbComment" text="Comment" font="font:MediumSystemFont" color="0xE2E8F0FF" width="1160" wrap="true" maxLines="4" translation="[20, 520]" />

            <!-- Hidden legacies -->
            <Rectangle id="bbImageFrame" visible="false"><Poster id="bbAttachedImage" /></Rectangle>
            <Rectangle id="bbQrBg" visible="false"><Poster id="bbQrCode" /></Rectangle>
          </Group>
        </Group>
      </Rectangle>
    </Group>


    <!-- Main Stage Reaction Bar -->
    <Group id="mainReactionBar" translation="[740, 1000]">
      <Rectangle id="bgFire" width="80" height="40" color="0x334155AA" translation="[0, 0]">
        <Poster uri="pkg:/images/icon_fire.png" width="24" height="24" translation="[8, 8]" />
        <Label id="lblFire" text="0" font="font:SmallBoldSystemFont" color="0xCBD5E1FF" translation="[36, 12]" />
      </Rectangle>
      <Rectangle id="bgThink" width="80" height="40" color="0x334155AA" translation="[90, 0]">
        <Poster uri="pkg:/images/icon_think.png" width="24" height="24" translation="[8, 8]" />
        <Label id="lblThink" text="0" font="font:SmallBoldSystemFont" color="0xCBD5E1FF" translation="[36, 12]" />
      </Rectangle>
      <Rectangle id="bgIdea" width="80" height="40" color="0x334155AA" translation="[180, 0]">
        <Poster uri="pkg:/images/icon_idea.png" width="24" height="24" translation="[8, 8]" />
        <Label id="lblIdea" text="0" font="font:SmallBoldSystemFont" color="0xCBD5E1FF" translation="[36, 12]" />
      </Rectangle>
      <Rectangle id="bgHundred" width="80" height="40" color="0x334155AA" translation="[270, 0]">
        <Poster uri="pkg:/images/icon_100.png" width="24" height="24" translation="[8, 8]" />
        <Label id="lblHundred" text="0" font="font:SmallBoldSystemFont" color="0xCBD5E1FF" translation="[36, 12]" />
      </Rectangle>
      <Rectangle id="bgDown" width="80" height="40" color="0x334155AA" translation="[360, 0]">
        <Poster uri="pkg:/images/icon_down.png" width="24" height="24" translation="[8, 8]" />
        <Label id="lblDown" text="0" font="font:SmallBoldSystemFont" color="0xCBD5E1FF" translation="[36, 12]" />
      </Rectangle>
    </Group>

    <!-- Progress Bar -->
    <Group id="progressBarGroup" translation="[0, 1072]" visible="true">
      <Rectangle width="1920" height="8" color="0x1E293B88" />
      <Rectangle id="progressFill" width="0" height="8" color="0x38BDF8FF" />
    </Group>

    <!-- Global Dynamic QR Code Pinned to Corner -->
    <Rectangle id="globalQrBg" width="240" height="280" color="0xFFFFFFFF" translation="[1620, 40]" visible="false">
      <Poster id="globalQrCode" width="232" height="232" translation="[4, 4]" />
      <Label text="Scan to comment" font="font:SmallBoldSystemFont" color="0x0F172AFF" translation="[0, 246]" horizAlign="center" width="240" />
    </Rectangle>

    <!-- Phase 2: Compact Floating Annotation Bubble -->
    <FloatingAnnotationBubble id="annotationBubble" />

    <!-- Full-Screen Detail View Modal with Dynamic QR Code -->
    <Group id="detailModalGroup" visible="false" translation="[0, 0]">
      <!-- Dim Scrim Backdrop -->
      <Rectangle
        width="1920"
        height="1080"
        color="0x030712F0" />

      <!-- Center Modal Card Surface -->
      <Rectangle
        id="detailModalCard"
        width="1560"
        height="760"
        color="0x0B1220FC"
        translation="[180, 140]">
        
        <!-- Top Cyan Accent Line -->
        <Rectangle
          width="1560"
          height="6"
          color="0x38BDF8FF" />

        <!-- Modal Header Row -->
        <Group translation="[50, 32]">
          <Rectangle
            id="modalPlatformBg"
            width="170"
            height="34"
            color="0x1E293BEE">
            <Label
              id="modalPlatform"
              text="X / Twitter"
              font="font:SmallBoldSystemFont"
              color="0x38BDF8FF"
              horizAlign="center"
              width="170"
              translation="[0, 8]" />
          </Rectangle>

          <Label
            id="modalDomain"
            text="x.com"
            font="font:SmallSystemFont"
            color="0x94A3B8FF"
            translation="[190, 8]" />
        </Group>

        <!-- Left Column: Source & Community Annotation (Width: 920px) -->
        <Group translation="[50, 90]">
          <!-- Author Handle -->
          <Label
            id="modalAuthor"
            text="@magnetarsenti"
            font="font:LargeBoldSystemFont"
            color="0x38BDF8FF"
            translation="[0, 0]" />

          <!-- Page Title / Headline -->
          <Label
            id="modalTitle"
            text="Annotated Source Title"
            font="font:MediumBoldSystemFont"
            color="0xFFFFFFFF"
            width="900"
            wrap="true"
            maxLines="2"
            translation="[0, 48]" />

          <!-- Quote Block -->
          <Rectangle
            width="900"
            height="230"
            color="0x111827EE"
            translation="[0, 116]">
            <Rectangle width="6" height="230" color="0x38BDF8FF" />
            <Label
              text="ORIGINAL SOURCE QUOTE"
              font="font:SmallBoldSystemFont"
              color="0x38BDF8FF"
              translation="[20, 14]" />
            <Label
              id="modalQuote"
              text="Public quote from verified webpage or video"
              font="font:MediumSystemFont"
              color="0xF8FAFCFF"
              width="850"
              wrap="true"
              maxLines="5"
              lineSpacing="6"
              translation="[20, 48]" />
          </Rectangle>

          <!-- Commentary Block -->
          <Rectangle
            width="900"
            height="200"
            color="0x111827EE"
            translation="[0, 366]">
            <Rectangle width="6" height="200" color="0x34D399FF" />
            <Label
              text="COMMUNITY COMMENTARY &amp; FACT CHECK"
              font="font:SmallBoldSystemFont"
              color="0x34D399FF"
              translation="[20, 14]" />
            <Label
              id="modalComment"
              text="Community commentary"
              font="font:MediumSystemFont"
              color="0xE2E8F0FF"
              width="850"
              wrap="true"
              maxLines="4"
              translation="[20, 48]" />
          </Rectangle>
        </Group>

        <!-- Right Column: Clean QR Code Card (Width: 470px) -->
        <Group translation="[1040, 90]">
          <!-- QR Card Container -->
          <Rectangle
            width="470"
            height="580"
            color="0x1E293B88"
            translation="[0, 0]">
            <Rectangle width="470" height="4" color="0x38BDF8FF" />

            <!-- White high-contrast backing for camera scanning -->
            <Rectangle
              id="modalQrBg"
              width="390"
              height="390"
              color="0xFFFFFFFF"
              translation="[40, 95]">
              <Poster
                id="modalQrCode"
                width="374"
                height="374"
                translation="[8, 8]" />
            </Rectangle>
          </Rectangle>
        </Group>
      </Rectangle>
    </Group>
  </children>
</component>

