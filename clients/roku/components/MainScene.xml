          text="annotated"
          font="font:LargeBoldSystemFont"
          color="0xF8FAFCFF"
          translation="[-115, -22]" />
        <Label
          id="introPeriod"
          text="."
          font="font:LargeBoldSystemFont"
          color="0xEF4444FF"
          translation="[98, -22]" />
      </Group>

      <!-- SceneGraph Slow-Zoom Animation Sequence (Netflix/Prime Style) -->
      <Animation id="introAnim" duration="2.8" repeat="false" easeFunction="linear">
        <Vector2DFieldInterpolator
          key="[0.0, 1.0]"
          keyValue="[[0.90, 0.90], [1.16, 1.16]]"
          fieldToInterp="introWordmarkGroup.scale" />

        <FloatFieldInterpolator
          key="[0.0, 0.25, 0.75, 1.0]"
          keyValue="[0.0, 1.0, 1.0, 0.0]"
          fieldToInterp="introWordmarkGroup.opacity" />

        <FloatFieldInterpolator
          key="[0.0, 0.8, 1.0]"
          keyValue="[1.0, 1.0, 0.0]"
          fieldToInterp="introOverlay.opacity" />
      </Animation>
    </Group>

