{
  "manifest_version": 3,
  "name": "Annotated — Web Annotation Layer",
  "version": "2.0.0",
  "description": "Highlight, contextualize, and share the web.",
  "permissions": [
    "storage",
    "activeTab",
    "sidePanel",
    "contextMenus",
    "identity",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "oauth2": {
    "client_id": "343335882944-fir4aehjgkvnj0r6tdg0mmcc2sjt99vf.apps.googleusercontent.com",
    "scopes": [
      "openid",
      "email",
      "profile"
    ]
  },
  "action": {
    "default_title": "Open Annotated"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  }
}
